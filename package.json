{
  "name": "pest-runner-icons",
  "displayName": "Pest Runner Icons",
  "description": "Add CodeLens icons to run Pest Laravel tests",
  "version": "0.0.2",
  "publisher": "dark-shadow",
  "author": {
    "name": "dark SHADOW",
    "url": "https://github.com/bool-kev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bool-kev/pest-runner-icons"
  },
  "bugs": {
    "url": "https://github.com/bool-kev/pest-runner-icons/issues"
  },
  "homepage": "https://github.com/bool-kev/pest-runner-icons#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Testing"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pest-runner-icons.runTest",
        "title": "Run Test",
        "icon": "$(play)"
      },
      {
        "command": "pest-runner-icons.runTestFile",
        "title": "Run Test File",
        "icon": "$(run-all)"
      },
      {
        "command": "pest-runner-icons.runTestSuite",
        "title": "Run Test Suite",
        "icon": "$(run-all)"
      },
      {
        "command": "pest-runner-icons.runDescribeGroup",
        "title": "Run Describe Group",
        "icon": "$(run-all)"
      }
    ],
    "configuration": {
      "title": "Pest Runner Icons",
      "properties": {
        "pest-runner-icons.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeLens for Pest tests"
        },
        "pest-runner-icons.useBetterPest": {
          "type": "boolean",
          "default": true,
          "description": "Use Better Pest commands instead of built-in commands"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "esbuild": "^0.25.10",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}